{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emirmoralioglu-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "emirmoralioglu.com", "custom_domain": true },
    { "pattern": "www.emirmoralioglu.com", "custom_domain": true }
  ]
}
